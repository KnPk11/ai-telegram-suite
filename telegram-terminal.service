[Unit]
Description=AI Telegram Terminal Suite Daemon
After=network.target

[Service]
Type=simple
# Replace with your system user and installation path
User=root
WorkingDirectory=/opt/telegram-terminal
ExecStart=/usr/bin/node /opt/telegram-terminal/bot.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
