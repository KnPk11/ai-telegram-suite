# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Authorised Telegram numeric user ID(s) (comma-separated for multiple users)
# Access is strictly tied to the sender's user ID (fromId). Group IDs are not permitted.
ALLOWED_CHAT_IDS=

# Default working directory (defaults to current working directory or user home if omitted)
# DEFAULT_WORKSPACE=/path/to/workspace

# Engine binaries. OpenCode's prompt is positional; do not pass it with -p.
# AGY_BIN=/usr/local/bin/agy
# GROK_BIN=/usr/local/bin/grok
# OPENCODE_BIN=/root/.opencode/bin/opencode

# DEFAULT_ENGINE=agy
# DEFAULT_OPENCODE_MODEL=opencode/big-pickle
# DEFAULT_OPENCODE_EFFORT=

