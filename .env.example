# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Authorised Telegram numeric user ID(s) (comma-separated for multiple users)
# Access is strictly tied to the sender's user ID (fromId). Group IDs are not permitted.
ALLOWED_CHAT_IDS=

# Default working directory (defaults to current working directory or user home if omitted)
# DEFAULT_WORKSPACE=/path/to/workspace

